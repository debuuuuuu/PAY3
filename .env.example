# =============================================================================
# Pay3 environment configuration
# Copy to .env and fill in values before running the backend.
# =============================================================================

# --- Runtime (API @pay3/api) ---
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# --- CORS (comma-separated dashboard origins) ---
CORS_ORIGINS=http://localhost:3000

# --- Stellar network ---
# testnet | public
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_USDC_ISSUER=GA5ZSEJYB37J5ADS5US63LG475ZPZPGDAZJBZJ7BU3AP3RBK6X3H3
# SOROBAN_SMART_ACCOUNT_CONTRACT_ID=

# --- Wallet authentication + web session ---
# Min 32 characters; used after wallet signature verification
AUTH_SESSION_SECRET=replace-with-a-cryptographically-random-string-at-least-32-chars
AUTH_CHALLENGE_TTL_MS=300000
AUTH_SESSION_COOKIE_NAME=pay3_session
AUTH_SESSION_MAX_AGE_MS=86400000

# --- AI session key encryption (AES-256-GCM) ---
# 64 hex characters (32 bytes) OR base64 encoding of exactly 32 bytes
SESSION_KEY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- MCP server (@pay3/mcp-server) ---
API_BASE_URL=http://localhost:3001
# When running MCP alongside the API: PORT=3002 npm run dev:mcp
# Copy mcpAuthToken from POST /api/ai-sessions (needed for npm run dev:mcp)
PAY3_MCP_AUTH_TOKEN=

# --- Next.js dashboard (frontend) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
