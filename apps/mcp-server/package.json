    "@pay3/policy-engine": "*",
    "@pay3/recipient-resolver": "*",
    "@pay3/session-manager": "*",
    "@pay3/shared": "*",
    "@pay3/stellar": "*",
    "@pay3/transaction-engine": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.5"
  }
}
