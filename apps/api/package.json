{
  "name": "@pay3/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "self-check": "tsx scripts/middleware-self-check.ts && tsx scripts/workers-self-check.ts && tsx scripts/analytics-self-check.ts",
    "test": "npm run self-check && node --import tsx --test tests/integration.test.ts"
  },
  "dependencies": {
    "@pay3/auth": "*",
    "@pay3/database": "*",
    "@pay3/policy-engine": "*",
    "@pay3/recipient-resolver": "*",
    "@pay3/session-manager": "*",
    "@pay3/shared": "*",
    "@pay3/stellar": "*",
    "@pay3/transaction-engine": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^26.1.1",
    "tsx": "^4.20.5"
  }
}
