# Copy to your API host dashboard (Railway / Render / Fly) — never commit real values.

NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://YOUR_VERCEL_DOMAIN

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

SMART_ACCOUNT_ENCRYPTION_KEY=generate-a-long-random-string-at-least-32-chars

STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
STELLAR_HORIZON_URL=https://horizon.stellar.org
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
# Optional testnet (switch all three together):
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Optional override — defaults to Asset.native().contractId(passphrase)
# NATIVE_SAC_CONTRACT_ID=
# Comma-separated sha256 of deployed WASM (enable-contract-custody allowlist)
# PAY3_ALLOWED_WASM_HASHES=
# Backend-only fee payer / optional mainnet jar seeder (never expose to clients)
# RELAYER_SECRET=S...
# MAINNET_JAR_SEED_XLM=2
# Optional canary deployer (npm run canary:deploy) — fund deployer G first
# CANARY_DEPLOYER_SECRET=S...
# CANARY_OWNER_G=G...
# CANARY_OWNER_SECRET=S...
# CANARY_FUNDER_SECRET=S...
# CANARY_FUND_XLM=5
# SOROSWAP_NETWORK=mainnet
# SOROSWAP_API_KEY=
