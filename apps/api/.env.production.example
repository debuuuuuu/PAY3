# Copy to your API host dashboard (Railway / Render / Fly) — never commit real values.

NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://YOUR_VERCEL_DOMAIN

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

SMART_ACCOUNT_ENCRYPTION_KEY=generate-a-long-random-string-at-least-32-chars

STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# Mainnet (switch all three together):
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# STELLAR_HORIZON_URL=https://horizon.stellar.org
# STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
# Optional override — defaults to Asset.native().contractId(passphrase)
# NATIVE_SAC_CONTRACT_ID=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
# Comma-separated sha256 of deployed WASM (enable-contract-custody allowlist)
# PAY3_ALLOWED_WASM_HASHES=842c28f0f4db756cfbe259553993fd1045c0df32966b4bebff9d94720490e5e0
# Backend-only fee payer for contract submits (never expose to clients)
# RELAYER_SECRET=S...
# Optional canary deployer (npm run canary:deploy) — mainnet: fund deployer G with ~3 XLM first
# CANARY_DEPLOYER_SECRET=S...
# CANARY_OWNER_G=G...
# CANARY_OWNER_SECRET=S...
# CANARY_FUNDER_SECRET=S...
# CANARY_FUND_XLM=5
