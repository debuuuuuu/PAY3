PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Neon PostgreSQL — see docs/DATABASE.md
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Encrypts allocation-account secrets at rest (any long random string)
SMART_ACCOUNT_ENCRYPTION_KEY="change-me-to-a-long-random-secret"

# Optional — Soroswap aggregator (MCP get_swap_quote + opt-in execute_swap)
# Register at https://api.soroswap.finance — never expose to the frontend
# SOROSWAP_NETWORK must match STELLAR_NETWORK_PASSPHRASE (testnet vs mainnet)
# Testnet pools are often empty → mainnet quotes work; execute needs funds on that network
# SOROSWAP_API_KEY=
# SOROSWAP_NETWORK=mainnet
# SOROSWAP_API_URL=https://api.soroswap.finance
